# =============================================================================
# Marathon Management Platform — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# PostgreSQL connection string. asyncpg driver used by FastAPI; psycopg2 used
# by Celery workers (the app converts the URL automatically).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://marathon:marathon@localhost:5432/marathon_db

# -----------------------------------------------------------------------------
# Redis (REQUIRED)
# Used as Celery broker and result backend.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# JWT (REQUIRED)
# SECRET_KEY must be a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# MinIO / S3-compatible object storage (REQUIRED)
# Stores QR code PNGs and certificate PDFs.
# MINIO_SECURE=false for local HTTP; set true for HTTPS in production.
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=marathon-files
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# SMTP — Email delivery (OPTIONAL)
# If SMTP_HOST is left empty or unset, the app falls back to stub logging:
#   [EMAIL STUB] To: ..., Subject: ...
# Set all five vars to enable real email delivery via smtplib.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Twilio — WhatsApp delivery (OPTIONAL)
# If any of the three Twilio vars are empty/unset, WhatsApp falls back to stub:
#   [WHATSAPP STUB] To: ..., Message: ...
# TWILIO_WHATSAPP_FROM is the Twilio sandbox/production number (digits only,
# no "whatsapp:" prefix — the app adds it automatically).
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# -----------------------------------------------------------------------------
# Frontend (Vite) — set in marathon-frontend/.env
# VITE_API_URL: backend base URL. Leave empty when using nginx proxy in Docker.
# VITE_EVENT_ID: UUID of the default event shown on the landing page.
# -----------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000
# VITE_EVENT_ID=00000000-0000-0000-0000-000000000001

# -----------------------------------------------------------------------------
# Admin seed (used by scripts/seed_admin.py only)
# Run: python scripts/seed_admin.py
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Platform Admin
